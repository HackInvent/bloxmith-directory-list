{
  "kind": "directory_list",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Directory List",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "folder",
        "title": "Folder",
        "accepts": [
          "directory/path",
          "file/path",
          "message/*",
          "application/json"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "liste",
        "title": "Files",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "folder_path": "",
    "pattern": "*",
    "recursive": false
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "file_browser": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "all_inputs"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "js",
        "path": "assets/js/common.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
